# Travelpayouts (https://www.travelpayouts.com) - free signup, get token + marker
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Telegram bot (via @BotFather) + your chat id (message the bot, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SerpApi (serpapi.com) - optional, only used to live-recheck possible
# error fares (>=50% below median) before alerting. Without it, error
# fares still alert directly off cached Travelpayouts data.
SERPAPI_KEY=

# Telethon (public Telegram channel monitoring) - optional, only needed if
# promos.telegram_channels.enabled is true. From my.telegram.org -> "API
# development tools" -> create an app. Also needs a one-time interactive
# login: `python -m travel_tracker.telegram_channels.login`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Path to the SQLite database file (defaults to ./data/tracker.db if unset)
DATABASE_PATH=
